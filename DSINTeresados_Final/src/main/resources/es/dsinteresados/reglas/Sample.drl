package es.dsinteresados.reglas;
 
import es.dsinteresados.clases.*;
import java.util.Set;
import java.util.List;

global List<String> salidaDrools;

//regla 1
rule "Si Poseidon enojado criatura marina libre"
	no-loop true
	when
		$pos : Dios (nombre == "Poseidon")
		$cas : Mortal ()
		eval ($pos.containsOtorgaEnojoA($cas)) 
		$cet : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad != Personaje.EstadoLibertad.Libre)
	then
		modify($cet) {setEstadoLibertad(Personaje.EstadoLibertad.Libre)}
		salidaDrools.add($cet.getNombre() + " queda libre debido al enojo de " + $pos.getNombre() + "  hacia " + $cas.getNombre());
end
 
//regla 2a
rule "Si Ceto libre y Poseidon enojado con Casiopea Andromeda presa"
	no-loop true
	when
		$pos : Dios (nombre == "Poseidon")
		$cas : Mortal (nombre == "Casiopea")
		eval ($pos.containsOtorgaEnojoA($cas))
		$cet : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$and : Mortal (nombre == "Andromeda", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
	then
		modify($and) {setEstadoLibertad(Personaje.EstadoLibertad.Preso)}
		modify($cet) {addConoceUbicacion($and)}
		salidaDrools.add($and.getNombre() + " queda presa debido a estar " + $cet.getNombre() + " libre");
end

//regla 2b
rule "Si Criatura libre y Poseidon enojado con el prisionero directamente"
	no-loop true
	when
		$pos : Dios (nombre == "Poseidon")
		$pr : Mortal (nombre != "Casiopea", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		eval ($pos.containsOtorgaEnojoA($pr))
		$cet : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
	then
		modify($pr) {setEstadoLibertad(Personaje.EstadoLibertad.Preso)}
		modify($cet) {addConoceUbicacion($pr)}
		salidaDrools.add($pr.getNombre() + " queda preso debido a estar " + $cet.getNombre() + " libre");
end

//regla 3
rule "Si Mortal tiene Favor de Dios obtiene Objeto"
	no-loop true
	when
		$p : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$d : Dios ()
		$o : Objeto ()
		eval ($p.containsTieneFavorDe($d))
		eval ($d.containsTieneObjetos($o))
	then
		modify($p) {addTieneObjetos($o)}
		modify($d) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a tener el favor de " + $d.getNombre());
end

//regla 4
rule "Si Mortal tiene Escudo de Bronce y Favor de Hefesto obtiene Escudo-Espejo"
	no-loop true
	when
		$m : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$e : Objeto (nombre == "Escudo de Bronce")
		$h : Dios (nombre == "Hefesto")
		$hab : Habilidad (nombre == "Espejo")
		eval($m.containsTieneFavorDe($h))
		eval($m.containsTieneObjetos($e))
	then
		Equipamiento $es = new Equipamiento("Escudo-Espejo", $m, $hab, true);
		insert($es);
		modify($m) {rmTieneObjetos($e), addTieneObjetos($es)}
		modify($e) {setPoseedor(null)}
		salidaDrools.add($m.getNombre() + " obtiene " + $es.getNombre() + " debido a tener el favor de " + $h.getNombre() + " y el " + $e.getNombre());
end

//regla 5
rule "Si Heroe tiene Objeto obtiene su Habilidad"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$e : Equipamiento ($hab : permiteHabilidad != null)
		eval($m.containsTieneObjetos($e))
		eval(!$m.containsTieneHabilidad($hab))
	then
		modify($m) {addTieneHabilidad($hab)}
		salidaDrools.add($m.getNombre() + " obtiene " + $hab.getNombre() + " debido a tener " + $e.getNombre());
end

//regla 6
rule "Heroe localiza las Grayas"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$hm : Dios (nombre == "Hermes")
		$at : Dios (nombre == "Atenea")
		$gr : Criatura (nombre == "las Grayas")
		eval ($m.containsTieneFavorDe($hm))
		eval ($m.containsTieneFavorDe($at))
		eval (!$m.containsConoceUbicacion($gr))
	then
		modify($m) {addConoceUbicacion($gr)}
		salidaDrools.add($m.getNombre() + " localiza a " + $gr.getNombre() + " debido a tener el favor de " + $hm.getNombre() + " y " + $at.getNombre());
end

//regla 7
rule "Heroe roba a las Grayas"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$gr : Criatura (nombre == "las Grayas")
		$o : Objeto (nombre == "ojo/diente")
		$ni : Dios (nombre == "las Ninfas")
		$hab : Habilidad (nombre == "Invisibilidad")
		eval ($m.containsConoceUbicacion($gr))
		eval (!$m.containsConoceUbicacion($ni))
		eval ($m.containsTieneHabilidad($hab))
		eval ($gr.containsTieneObjetos($o))
	then
		modify($gr) {rmTieneObjetos($o)}
		modify($m) {addTieneObjetos($o)}
		modify($o) {setPoseedor($m)}
		salidaDrools.add($m.getNombre() + " obtiene el " + $o.getNombre() + " de " + $gr.getNombre() + " debido a tener " + $hab.getNombre() + " y " + $gr.getNombre() + " localizada");
end

//regla 8
rule "Heroe localiza a las Ninfas"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$gr : Criatura (nombre == "las Grayas")
		$o : Objeto (nombre == "ojo/diente")
		$ni : Dios (nombre == "las Ninfas")
		eval ($m.containsConoceUbicacion($gr))
		eval (!$m.containsConoceUbicacion($ni))
		eval ($m.containsTieneObjetos($o))
	then
		modify($m) {addConoceUbicacion($ni), rmTieneObjetos($o)}
		modify($gr) {addTieneObjetos($o)}
		modify($o) {setPoseedor($gr)}
		salidaDrools.add($m.getNombre() + " localiza a " + $ni.getNombre() + " debido a intercambio de " + $o.getNombre() + " de " + $gr.getNombre() + ", a " + $gr.getNombre());
end

//regla 9
rule "Si Heroe ha localizado a las Ninfas obtiene Objeto"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$n : Dios (nombre == "las Ninfas")
		$o : Objeto ()
		eval ($p.containsConoceUbicacion($n))
		eval ($n.containsTieneObjetos($o))
	then
		modify($p) {addTieneObjetos($o)}
		modify($n) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a " + $n.getNombre() + " localizada");
end

//regla 10
rule "Si Heroe posee Objeto mata a Medusa"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$m : Criatura (nombre == "Medusa", estadoVida == Personaje.EstadoVida.Vivo)
		$o1 : Objeto (nombre == "Hoz de Acero" || nombre == "Espada de Teseo" || nombre == "Cuerno del Minotauro")
		$hab : Habilidad (nombre == "Espejo")
		$hab1 : Habilidad (nombre == "Invisibilidad")
		$hab2 : Habilidad (nombre == "Vuelo")
		eval ($p.containsTieneObjetos($o1))
		eval ($p.containsTieneHabilidad($hab))
		eval ($p.containsTieneHabilidad($hab1))
		eval ($p.containsTieneHabilidad($hab2))
	then
		modify($m) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		salidaDrools.add($p.getNombre() + " mata a " + $m.getNombre() + " debido a tener " + $o1.getNombre() + ", " + $hab.getNombre() + ", " + $hab1.getNombre() + " y " + $hab2.getNombre());
end

//regla 11
rule "Heroe obtiene Objeto por matar a Medusa"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$m : Criatura (nombre == "Medusa", estadoVida == Personaje.EstadoVida.Muerto)
		$o : Objeto (nombre == "cabeza de Medusa")
		eval ($m.containsTieneObjetos($o))
	then
		modify($p) {addTieneObjetos($o)}
		modify($m) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a matar a " + $m.getNombre());		
end

//regla 12
rule "Si Mortal no posee Zurron Magico al obtener cabeza de Medusa muere"
	no-loop true
	when
		$p : Mortal (estadoVida == Personaje.EstadoVida.Vivo)
		$o : Objeto (nombre == "Zurron Magico")
		$c : Objeto (nombre == "cabeza de Medusa")
		eval (!$p.containsTieneObjetos($o))
		eval ($p.containsTieneObjetos($c))
	then
		modify($p) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		salidaDrools.add($p.getNombre() + " muere debido a no tener " + $o.getNombre() + " y haber cogido " + $c.getNombre());
end

//regla 13
rule "Si Heroe posee cabeza de Medusa mata a Criatura"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$c : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo)
		$o : Objeto (nombre == "cabeza de Medusa")
		$z : Objeto (nombre == "Zurron Magico")
		eval ($p.containsTieneObjetos($o))
		eval ($p.containsTieneObjetos($z))
	then
		modify($c) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		salidaDrools.add($p.getNombre() + " mata a " + $c.getNombre() + " debido a tener " + $o.getNombre());
end

//regla 14
rule "Si Heroe mata a Ceto libera a prisionero"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$c : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Muerto)
		$a : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		eval ($c.containsConoceUbicacion($a))
	then
		modify($a) {setEstadoLibertad(Personaje.EstadoLibertad.Libre)}
		modify($c) {rmConoceUbicacion($a)}
		salidaDrools.add($p.getNombre() + " libera a " + $a.getNombre() + " debido a matar a " + $c.getNombre());
end








