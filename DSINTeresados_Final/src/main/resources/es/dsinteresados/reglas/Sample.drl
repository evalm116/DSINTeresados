package es.dsinteresados.reglas;
 
import es.dsinteresados.clases.*;
import java.util.Set;
import java.util.List;

global List<String> salidaDrools;

rule "Imprimir estado inicial de personajes"
	agenda-group "Informacion Inicial"
	salience 20
	when
		$p : Personaje()
	then
		System.out.println($p.getNombre() + " presente y " + $p.getEstadoVida() + " y " + $p.getEstadoLibertad());
end

rule "Imprimir posesion inicial de objetos"
	agenda-group "Informacion Inicial"
	salience 15
	when
		$o : Objeto($pos : poseedor != null)
	then
		System.out.println($o.getNombre() + " esta en posesion de " + $pos.getNombre());
end

rule "Imprimir capacidades iniciales de heroes"
	agenda-group "Informacion Inicial"
	salience 10
	when
		$h : Heroe()
		$hab : Habilidad()
		eval($h.containsTieneHabilidad($hab))
	then
		System.out.println($h.getNombre() + " tiene la capacidad " + $hab.getNombre());
end

rule "Imprimir favores iniciales"
	agenda-group "Informacion Inicial"
	salience 5
	when
		$p1 : Personaje()
		$p2 : Personaje()
		eval($p1.containsTieneFavorDe($p2))
	then
		System.out.println($p1.getNombre() + " tiene el favor de " + $p2.getNombre());
end

rule "Imprimir enojos iniciales"
	agenda-group "Informacion Inicial"
	salience 5
	when
		$p1 : Personaje()
		$p2 : Personaje()
		eval($p1.containsOtorgaEnojoA($p2))
	then
		System.out.println($p2.getNombre() + " tiene el enojo de " + $p1.getNombre());
end

//regla 1
rule "Si Poseidon enojado criatura marina libre"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$pos : Dios (nombre == "Poseidon")
		$cas : Mortal ()
		eval ($pos.containsOtorgaEnojoA($cas)) 
		$cet : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad != Personaje.EstadoLibertad.Libre)
	then
		modify($cet) {setEstadoLibertad(Personaje.EstadoLibertad.Libre)}
		
		Accion liberar = new Accion($pos.getNombre()+" libera a "+$cas.getNombre(), $pos, $cas, Accion.Tipo.Liberar );
		insert(liberar);
		
		salidaDrools.add($cet.getNombre() + " queda libre debido al enojo de " + $pos.getNombre() + " hacia " + $cas.getNombre());
end
 
//regla 2a
// Nota: la diferencia entre 2a y 2b es que si poseidon está enfadado con Casiopea 
// es su hija, Andromeda, la que tiene que ser capturada (2a), mientras que cualquier 
// otro personaje se le captura debido al enojo (2b).
rule "Si Ceto libre y Poseidon enojado con Casiopea Andromeda presa"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$pos : Dios (nombre == "Poseidon")
		$cas : Mortal (nombre == "Casiopea")
		eval ($pos.containsOtorgaEnojoA($cas))
		$cet : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$and : Mortal (nombre == "Andromeda", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
	then
		modify($and) {setEstadoLibertad(Personaje.EstadoLibertad.Preso)}
		modify($cet) {addConoceUbicacion($and)}
				
		salidaDrools.add($and.getNombre() + " queda presa debido a estar " + $cet.getNombre() + " libre");
end

//regla 2b
rule "Si Criatura libre y Poseidon enojado con el prisionero directamente"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$pos : Dios (nombre == "Poseidon")
		$pr : Mortal (nombre != "Casiopea", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		eval ($pos.containsOtorgaEnojoA($pr))
		$cet : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
	then
		modify($pr) {setEstadoLibertad(Personaje.EstadoLibertad.Preso)}
		modify($cet) {addConoceUbicacion($pr)}
		salidaDrools.add($pr.getNombre() + " queda preso debido a estar " + $cet.getNombre() + " libre");
end

//regla 3a
rule "Si Mortal tiene Favor de Dios obtiene Objeto"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$d : Personaje ()
		$o : Objeto ()
		eval ($p.containsTieneFavorDe($d))
		eval ($d.containsTieneObjetos($o))
	then
		modify($p) {addTieneObjetos($o)}
		modify($d) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a tener el favor de " + $d.getNombre());
end

//regla 3b
rule "Si Mortal en Laberinto tiene Favor de Dios obtiene Objeto"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$t : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Vivo)
		$d : Personaje ()
		$o : Objeto ()
		eval ($p.containsConoceUbicacion($t))
		eval (!$t.containsConoceUbicacion($p))
		eval ($p.containsTieneFavorDe($d))
		eval ($d.containsTieneObjetos($o))
	then
		modify($p) {addTieneObjetos($o)}
		modify($d) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a tener el favor de " + $d.getNombre());
end

//regla 4
rule "Si Mortal tiene Escudo de Bronce y Favor de Hefesto obtiene Escudo-Espejo"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$m : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$e : Objeto (nombre == "Escudo de Bronce")
		$h : Dios (nombre == "Hefesto")
		$hab : Habilidad (nombre == "Espejo")
		eval($m.containsTieneFavorDe($h))
		eval($m.containsTieneObjetos($e))
	then
		Equipamiento $es = new Equipamiento("Escudo-Espejo", $m, $hab, true);
		insert($es);
		modify($m) {rmTieneObjetos($e), addTieneObjetos($es)}
		modify($e) {setPoseedor(null)}
		salidaDrools.add($m.getNombre() + " obtiene " + $es.getNombre() + " debido a tener el favor de " + $h.getNombre() + " y el " + $e.getNombre());
end

//regla 5
rule "Si Heroe tiene Objeto obtiene su Habilidad"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$e : Equipamiento ($hab : permiteHabilidad != null)
		eval($m.containsTieneObjetos($e))
		eval(!$m.containsTieneHabilidad($hab))
	then
		modify($m) {addTieneHabilidad($hab)}
		salidaDrools.add($m.getNombre() + " obtiene Capacidad " + $hab.getNombre() + " debido a tener " + $e.getNombre());
end

//regla 6
rule "Heroe localiza las Grayas"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$hm : Dios (nombre == "Hermes")
		$at : Dios (nombre == "Atenea")
		$gr : Criatura (nombre == "las Grayas")
		eval ($m.containsTieneFavorDe($hm))
		eval ($m.containsTieneFavorDe($at))
		eval (!$m.containsConoceUbicacion($gr))
	then
		modify($m) {addConoceUbicacion($gr)}
		salidaDrools.add($m.getNombre() + " localiza a " + $gr.getNombre() + " debido a tener el favor de " + $hm.getNombre() + " y " + $at.getNombre());
end

//regla 7
rule "Heroe roba a las Grayas"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$gr : Criatura (nombre == "las Grayas")
		$o : Objeto (nombre == "ojo/diente")
		$ni : Personaje (nombre == "las Ninfas")
		$hab : Habilidad (nombre == "Invisibilidad")
		eval ($m.containsConoceUbicacion($gr))
		eval (!$m.containsConoceUbicacion($ni))
		eval ($m.containsTieneHabilidad($hab))
		eval ($gr.containsTieneObjetos($o))
	then
		modify($gr) {rmTieneObjetos($o)}
		modify($m) {addTieneObjetos($o)}
		modify($o) {setPoseedor($m)}
		salidaDrools.add($m.getNombre() + " obtiene el " + $o.getNombre() + " de " + $gr.getNombre() + " debido a tener " + $hab.getNombre() + " y " + $gr.getNombre() + " localizada");
end

//regla 8
rule "Heroe localiza a las Ninfas"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$m : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$gr : Criatura (nombre == "las Grayas")
		$o : Objeto (nombre == "ojo/diente")
		$ni : Personaje (nombre == "las Ninfas")
		eval ($m.containsConoceUbicacion($gr))
		eval (!$m.containsConoceUbicacion($ni))
		eval ($m.containsTieneObjetos($o))
	then
		modify($m) {addConoceUbicacion($ni), rmTieneObjetos($o)}
		modify($gr) {addTieneObjetos($o)}
		modify($o) {setPoseedor($gr)}
		salidaDrools.add($m.getNombre() + " localiza a " + $ni.getNombre() + " debido a intercambio de " + $o.getNombre() + " de " + $gr.getNombre() + ", a " + $gr.getNombre());
end

//regla 9
rule "Si Heroe ha localizado a las Ninfas obtiene Objeto"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$n : Personaje (nombre == "las Ninfas")
		$o : Objeto ()
		eval ($p.containsConoceUbicacion($n))
		eval ($n.containsTieneObjetos($o))
	then
		modify($p) {addTieneObjetos($o)}
		modify($n) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a " + $n.getNombre() + " localizada");
end

//regla 10
rule "Si Heroe posee Objeto mata a Medusa"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$m : Criatura (nombre == "Medusa", estadoVida == Personaje.EstadoVida.Vivo)
		$o1 : Objeto (nombre == "Hoz de Acero" || nombre == "Espada de Teseo" || nombre == "Cuerno del Minotauro")
		$hab : Habilidad (nombre == "Espejo")
		$hab1 : Habilidad (nombre == "Invisibilidad")
		$hab2 : Habilidad (nombre == "Vuelo")
		eval ($p.containsTieneObjetos($o1))
		eval ($p.containsTieneHabilidad($hab))
		eval ($p.containsTieneHabilidad($hab1))
		eval ($p.containsTieneHabilidad($hab2))
	then
		modify($m) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		
		Accion matar = new Accion("Matar a Medusa", $p, $m, Accion.Tipo.Matar);
		insert(matar);
		
		salidaDrools.add($p.getNombre() + " mata a " + $m.getNombre() + " debido a tener " + $o1.getNombre() + ", " + $hab.getNombre() + ", " + $hab1.getNombre() + " y " + $hab2.getNombre());
end

//regla 11
rule "Heroe obtiene Objeto por matar a Criatura"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$m : Criatura (nombre == "Medusa" || nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Muerto)
		$o : Objeto ()
		$z : Objeto (nombre == "Zurron Magico")
		eval ($m.containsTieneObjetos($o))
		eval (!$o.getNombre().equals("cabeza de Medusa") || $p.containsTieneObjetos($z))
	then
		modify($p) {addTieneObjetos($o)}
		modify($m) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a matar a " + $m.getNombre());		
end

//regla 12
rule "Si Mortal no posee Zurron Magico al obtener cabeza de Medusa muere"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Mortal (estadoVida == Personaje.EstadoVida.Vivo)
		$o : Objeto (nombre == "Zurron Magico")
		$c : Objeto (nombre == "cabeza de Medusa")
		eval (!$p.containsTieneObjetos($o))
		eval ($p.containsTieneObjetos($c))
	then
		modify($p) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		
		//TODO: ver si hay que poner una accion de muerte
		
		salidaDrools.add($p.getNombre() + " muere debido a no tener " + $o.getNombre() + " y haber cogido " + $c.getNombre());
end

//regla 13
rule "Si Heroe posee cabeza de Medusa mata a Criatura"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$c : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Vivo)
		$o : Objeto (nombre == "cabeza de Medusa")
		$z : Objeto (nombre == "Zurron Magico")
		eval ($p.containsTieneObjetos($o))
		eval ($p.containsTieneObjetos($z))
		not ($zeus : Dios (nombre == "Zeus") and $rival : Heroe (estadoVida == Personaje.EstadoVida.Vivo) and eval ($rival != $p && $rival.containsTieneFavorDe($zeus)))
	then
		modify($c) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		
		Accion matar = new Accion($p.getNombre()+" mata a "+$c.getNombre(), $p, $c, Accion.Tipo.Matar);
		insert(matar); 
		
		salidaDrools.add($p.getNombre() + " mata a " + $c.getNombre() + " debido a tener " + $o.getNombre());
end

//regla 14
rule "Si Heroe mata a Ceto libera a prisionero"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$c : Criatura (nombre == "Ceto" || nombre == "Kraken", estadoVida == Personaje.EstadoVida.Muerto)
		$m : Accion(tipoAccion == Accion.Tipo.Matar, autor == $p, objetivo == $c)
		$a : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		eval ($c.containsConoceUbicacion($a))
	then
		modify($a) {setEstadoLibertad(Personaje.EstadoLibertad.Libre)}
		modify($c) {rmConoceUbicacion($a)}
		
		Accion liberar = new Accion($p.getNombre()+" libera a "+$a.getNombre(), $p, $a, Accion.Tipo.Liberar);
		insert(liberar);
		 
		salidaDrools.add($p.getNombre() + " libera a " + $a.getNombre() + " debido a matar a " + $c.getNombre());
end

//regla 15
rule "Si Minos enojado con Mortal este queda preso en Laberinto"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$m : Personaje (nombre == "Minos")
		$a : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$t : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Vivo)
		eval ($m.containsOtorgaEnojoA($a))
		eval(!$a.containsConoceUbicacion($t))
	then 
		modify($a) {setEstadoLibertad(Personaje.EstadoLibertad.Preso), addConoceUbicacion($t)}
		salidaDrools.add($a.getNombre() + " queda preso en Laberinto debido al enojo de " + $m.getNombre() + " hacia " + $a.getNombre());
end

//regla 16
rule "Mortal en Laberinto queda preso de Minotauro por no tener Hilo de Ariadna"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$a : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$t : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Vivo)
		$h : Objeto (nombre == "Hilo de Ariadna")
		not ($r : Personaje (nombre == "Ariadna") and eval ($a.containsTieneFavorDe($r)))
		eval (!$a.containsTieneObjetos($h))
		eval ($a.containsConoceUbicacion($t))
		eval (!$t.containsConoceUbicacion($a))
	then 
		modify($t) {addConoceUbicacion($a)}
		salidaDrools.add($a.getNombre() + " queda preso de " + $t.getNombre() + " debido a no tener " + $h.getNombre());
end

//regla 17
rule "Teseo mata a Minotauro debido a tener Espada de Teseo y Hilo de Ariadna"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$h : Heroe(estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$t : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Vivo)
		$i : Objeto (nombre == "Hilo de Ariadna")
		$a : Objeto (nombre == "Espada de Teseo" || nombre == "Hoz de Acero")
		eval ($h.containsConoceUbicacion($t))
		eval (!$t.containsConoceUbicacion($h))
		eval ($h.containsTieneObjetos($i))
		eval ($h.containsTieneObjetos($a))	
	then
		modify($t) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		
		Accion matar = new Accion($h.getNombre()+" mata a "+$t.getNombre(), $h, $t, Accion.Tipo.Matar);
		insert(matar);
		
		salidaDrools.add($h.getNombre() + " mata a " + $t.getNombre() + " debido a tener " + $a.getNombre() + " y " + $i.getNombre());
end

//regla 18
rule "Heroe recoge Objeto tras matar Minotauro"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$m : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Muerto)
		$o : Objeto ()
		eval ($p.containsConoceUbicacion($m))
		eval (!$m.containsConoceUbicacion($p))
		eval ($m.containsTieneObjetos($o))
	then
		modify($p) {addTieneObjetos($o)}
		modify($m) {rmTieneObjetos($o)}
		modify($o) {setPoseedor($p)}
		salidaDrools.add($p.getNombre() + " obtiene " + $o.getNombre() + " debido a matar a " + $m.getNombre());		
end

//regla 19
rule "Heroe libera a preso de Minotauro al matarlo"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$h : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$m : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Muerto)
		$o : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$a : Accion (autor == $h, objetivo == $m, tipoAccion == Accion.Tipo.Matar);
		eval ($h.containsConoceUbicacion($m))
		eval ($m.containsConoceUbicacion($o))
	then
		modify($o) {setEstadoLibertad(Personaje.EstadoLibertad.Libre), rmConoceUbicacion($m)}
		modify($m) {rmConoceUbicacion($o)}
		
		Accion liberar = new Accion($h.getNombre()+" libera a "+$o.getNombre(), $h, $o, Accion.Tipo.Liberar);
		insert(liberar);
		
		salidaDrools.add($h.getNombre() + " libera a " + $o.getNombre() + " debido a matar a " + $m.getNombre());
end

//regla 20
rule "Heroe queda libre del Laberinto por tener Hilo de Ariadna"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$h : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$m : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Muerto)
		$i : Objeto (nombre == "Hilo de Ariadna")
		eval ($h.containsConoceUbicacion($m))
		eval ($h.containsTieneObjetos($i))
		not ($o : Mortal (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
			and eval ($m.containsConoceUbicacion($o)))
	then
		modify($h) {setEstadoLibertad(Personaje.EstadoLibertad.Libre), rmConoceUbicacion($m)}
		salidaDrools.add($h.getNombre() + " queda libre debido a tener " + $i.getNombre());
end

//regla 21
rule "Minos encierra a Dedalo e Icaro tras morir Minotauro"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$min : Personaje (nombre == "Minos")
		$mt : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Muerto)
		$ded : Heroe (nombre == "Dedalo", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$ica : Heroe (nombre == "Icaro", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		not ($h : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
			and eval ($h.containsConoceUbicacion($mt)))
	then
		modify($min) {addOtorgaEnojoA($ded)}
		modify($ded) {setEstadoLibertad(Personaje.EstadoLibertad.Preso), addConoceUbicacion($mt)}
		modify($ica) {setEstadoLibertad(Personaje.EstadoLibertad.Preso), addConoceUbicacion($mt)}
		salidaDrools.add($ded.getNombre() + " queda preso en Laberinto debido al enojo de " + $min.getNombre() + " hacia " + $ded.getNombre() + " por morir " + $mt.getNombre());
		salidaDrools.add($ica.getNombre() + " queda preso en Laberinto debido al enojo de " + $min.getNombre() + " hacia " + $ded.getNombre() + " por morir " + $mt.getNombre());
end

//regla 22
rule "Dedalo obtiene materiales fabrica alas y ganan Capacidad Vuelo"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$mt : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Muerto)
		$ded : Heroe (nombre == "Dedalo", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$ica : Heroe (nombre == "Icaro", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$cera : Objeto (nombre == "Cera de Abejas")
		$plumas : Objeto (nombre == "Plumas")
		$hab : Habilidad (nombre == "Vuelo")
		eval ($ded.containsConoceUbicacion($mt))
		eval ($ica.containsConoceUbicacion($mt))
		eval (!$ded.containsTieneHabilidad($hab))
		eval (!$ica.containsTieneHabilidad($hab))
	then
		Equipamiento $alasD = new Equipamiento("Alas de Dedalo", $ded, $hab, true);
		Equipamiento $alasI = new Equipamiento("Alas de Icaro", $ica, $hab, true);
		insert($alasD);
		insert($alasI);
		modify($ded) {addTieneObjetos($alasD), addTieneHabilidad($hab)}
		modify($ica) {addTieneObjetos($alasI), addTieneHabilidad($hab)}
		salidaDrools.add($ded.getNombre() + " obtiene " + $cera.getNombre() + " y " + $plumas.getNombre() + " en Laberinto");
		salidaDrools.add($ded.getNombre() + " fabrica " + $alasD.getNombre() + " y " + $alasI.getNombre());
		salidaDrools.add($ded.getNombre() + " obtiene Capacidad " + $hab.getNombre() + " debido a tener " + $alasD.getNombre());
		salidaDrools.add($ica.getNombre() + " obtiene Capacidad " + $hab.getNombre() + " debido a tener " + $alasI.getNombre());
end

//regla 23
rule "Dedalo e Icaro escapan volando"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$mt : Criatura (nombre == "Minotauro", estadoVida == Personaje.EstadoVida.Muerto)
		$ded : Heroe (nombre == "Dedalo", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$ica : Heroe (nombre == "Icaro", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Preso)
		$hab : Habilidad (nombre == "Vuelo")
		$alasI : Equipamiento (nombre == "Alas de Icaro")
		eval ($ded.containsConoceUbicacion($mt))
		eval ($ica.containsConoceUbicacion($mt))
		eval($ded.containsTieneHabilidad($hab))
		eval($ica.containsTieneHabilidad($hab))
	then
		modify($ded) {setEstadoLibertad(Personaje.EstadoLibertad.Libre), rmConoceUbicacion($mt)}
		modify($ica) {setEstadoLibertad(Personaje.EstadoLibertad.Libre), setEstadoVida(Personaje.EstadoVida.Muerto), rmConoceUbicacion($mt), rmTieneObjetos($alasI)}
		modify($alasI) {setPoseedor(null)}
		salidaDrools.add($ded.getNombre() + " queda libre debido a tener Capacidad " + $hab.getNombre());
		salidaDrools.add($ica.getNombre() + " queda libre debido a tener Capacidad " + $hab.getNombre());
		salidaDrools.add($ica.getNombre() + " muere debido a escapar volando con " + $alasI.getNombre());
end

//regla 24
rule "Heroe repara Alas de Icaro"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$h : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$ica : Heroe (nombre == "Icaro", estadoVida == Personaje.EstadoVida.Muerto)
		$ni : Personaje (nombre == "las Ninfas")
		$alasI : Equipamiento (nombre == "Alas de Icaro", poseedor == null)
		$cera : Objeto (nombre == "Cera de Abejas")
		$plumas : Objeto (nombre == "Plumas")
		$hab : Habilidad (nombre == "Vuelo")
		eval ($h.containsConoceUbicacion($ni))
		eval (!$h.containsTieneHabilidad($hab))
	then
		modify($h) {addTieneObjetos($alasI)}
		modify($alasI) {setPoseedor($h)}
		salidaDrools.add($h.getNombre() + " repara y obtiene " + $alasI.getNombre() + " debido a tener " + $cera.getNombre() + " y " + $plumas.getNombre());
end

//regla 25
rule "Heroe mata a Medusa sin Vuelo cuando Pegaso va a nacer"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$p : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$m : Criatura (nombre == "Medusa", estadoVida == Personaje.EstadoVida.Vivo)
		$peg : Criatura (nombre == "Pegaso", estadoVida == Personaje.EstadoVida.Muerto)
		not (Criatura (nombre == "Ceto"))
		$o1 : Objeto (nombre == "Hoz de Acero" || nombre == "Espada de Teseo" || nombre == "Cuerno del Minotauro")
		$hab : Habilidad (nombre == "Espejo")
		$hab1 : Habilidad (nombre == "Invisibilidad")
		eval ($p.containsTieneObjetos($o1))
		eval ($p.containsTieneHabilidad($hab))
		eval ($p.containsTieneHabilidad($hab1))
	then
		modify($m) {setEstadoVida(Personaje.EstadoVida.Muerto)}
		
		Accion matar = new Accion($p.getNombre()+" mata a "+$m.getNombre(), $p, $m, Accion.Tipo.Matar);
		insert(matar);
		
		salidaDrools.add($p.getNombre() + " mata a " + $m.getNombre() + " debido a tener " + $o1.getNombre() + ", " + $hab.getNombre() + " y " + $hab1.getNombre());
end

//regla 26
rule "Pegaso nace tras morir Medusa"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$m : Criatura (nombre == "Medusa", estadoVida == Personaje.EstadoVida.Muerto)
		$peg : Criatura (nombre == "Pegaso", estadoVida == Personaje.EstadoVida.Muerto)
	then
		modify($peg) {setEstadoVida(Personaje.EstadoVida.Vivo), setEstadoLibertad(Personaje.EstadoLibertad.Libre)}
		salidaDrools.add($peg.getNombre() + " nace vivo y libre tras morir " + $m.getNombre());
end

//regla 27
rule "Heroe captura a Pegaso por tener Objeto y obtiene Habilidad"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$h : Heroe (estadoVida == Personaje.EstadoVida.Vivo, estadoLibertad == Personaje.EstadoLibertad.Libre)
		$peg : Criatura (nombre == "Pegaso", estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$bridas : Objeto (nombre == "Bridas de Oro")
		$hab : Habilidad (nombre == "Vuelo")
		eval ($h.containsTieneObjetos($bridas))
		eval (!$h.containsTieneHabilidad($hab))
	then
		modify($peg) {setEstadoLibertad(Personaje.EstadoLibertad.Preso)}
		modify($h) {addConoceUbicacion($peg), addTieneHabilidad($hab)}
		salidaDrools.add($h.getNombre() + " captura a " + $peg.getNombre() + " debido a tener " + $bridas.getNombre());
		salidaDrools.add($h.getNombre() + " obtiene Capacidad " + $hab.getNombre() + " debido a tener " + $peg.getNombre());
end

//regla 28a
rule "Heroe con favor de Zeus vence en primer duelo"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$zeus : Dios (nombre == "Zeus")
		$med : Criatura (nombre == "Medusa", estadoVida == Personaje.EstadoVida.Muerto)
		$ganador : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$perdedor : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$o1 : Objeto (nombre == "cabeza del Minotauro")
		$o2 : Objeto (nombre == "Espada de Teseo")
		eval ($ganador != $perdedor)
		eval ($ganador.containsTieneFavorDe($zeus))
		eval ($perdedor.containsTieneObjetos($o1))
		eval ($perdedor.containsTieneObjetos($o2))
	then
		modify($perdedor) {setEstadoVida(Personaje.EstadoVida.Muerto), rmTieneObjetos($o1), rmTieneObjetos($o2)}
		modify($ganador) {addTieneObjetos($o1), addTieneObjetos($o2)}
		modify($o1) {setPoseedor($ganador)}
		modify($o2) {setPoseedor($ganador)}
		
		Accion matar = new Accion($ganador.getNombre()+" mata a "+$perdedor.getNombre(), $ganador, $perdedor, Accion.Tipo.Matar);
		insert(matar);
		
		salidaDrools.add($ganador.getNombre() + " mata a " + $perdedor.getNombre() + " en duelo y obtiene " + $o1.getNombre() + " y " + $o2.getNombre());
end

//regla 28b
rule "Heroe con favor de Zeus vence en segundo duelo"
	agenda-group "Generacion Historias"
	no-loop true
	when
		$zeus : Dios (nombre == "Zeus")
		$ganador : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$perdedor : Heroe (estadoVida == Personaje.EstadoVida.Vivo , estadoLibertad == Personaje.EstadoLibertad.Libre)
		$cabMin : Objeto (nombre == "cabeza del Minotauro")
		$o1 : Objeto (nombre == "Zurron Magico")
		$o2 : Objeto (nombre == "cabeza de Medusa")
		eval ($ganador != $perdedor)
		eval ($ganador.containsTieneFavorDe($zeus))
		eval ($ganador.containsTieneObjetos($cabMin))
		eval ($perdedor.containsTieneObjetos($o1))
		eval ($perdedor.containsTieneObjetos($o2))
	then
		modify($perdedor) {setEstadoVida(Personaje.EstadoVida.Muerto), rmTieneObjetos($o1), rmTieneObjetos($o2)}
		modify($ganador) {addTieneObjetos($o1), addTieneObjetos($o2)}
		modify($o1) {setPoseedor($ganador)}
		modify($o2) {setPoseedor($ganador)}
				
		Accion matar = new Accion($ganador.getNombre()+" mata a "+$perdedor.getNombre(), $ganador, $perdedor, Accion.Tipo.Matar);
		insert(matar);
		
		salidaDrools.add($ganador.getNombre() + " mata a " + $perdedor.getNombre() + " en duelo y obtiene " + $o1.getNombre() + " y " + $o2.getNombre());
end