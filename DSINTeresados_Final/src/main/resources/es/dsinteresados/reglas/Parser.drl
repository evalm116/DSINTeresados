package es.dsinteresados.reglas;
 
import es.dsinteresados.parser.*;
import java.util.Set;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

global List<String> salidaDrools;


declare Tenencia
    sujeto : String
    resto  : String
end

rule "Parser: objetivo"
agenda-group "Parser"
salience 100
when
    // Solo lineas que empiezan por "<signo de interrogacion de apertura>Puede ..." (con o sin espacio)
    // Se usa \\u00BF en vez del caracter literal para que funcione con cualquier codificacion (Windows/Linux)
    $linea : String( this matches "^\\s*\\u00BF\\s*Puede\\b.*" )
then
    String limpia = $linea
            .replaceAll("(\\?|\\u00BF|Puede|\\ba\\b|\\bal\\b)", "")
            .trim();
    String[] partes = limpia.split("\\s+");

    if (partes.length >= 3) { // Solo Guardar si tiene tres partes despues de formato
        insert(new Objetivo(Objetivo.parsearTipo(partes[1]), partes[0], partes[2]));
    }

    delete($linea);   // Siempre elimina la linea 
end


rule "Parser: condicion no esta presente"
agenda-group "Parser"
salience 100
when
	$linea: String(this matches "(?is).*\\bno\\s+(?:esta\\s+presente|estan\\s+presentes)\\b.*")
then
 	Matcher m = Pattern
            .compile("^(.*?)\\s*\\bno\\s+(?:esta\\s+presente|estan\\s+presentes)\\b",
                     Pattern.CASE_INSENSITIVE | Pattern.DOTALL)
            .matcher($linea);
	//String[] a = $linea.split("\\s+no estan? presentes?\\s+");
	String sujeto = "";
	if (m.find()) {
		 sujeto = m.group(1);
	}
	Condicion.Tipo tipo = Condicion.Tipo.NoPresente;
	String predicado = null;
	
	insert(new Condicion(sujeto, tipo, predicado));
	delete($linea);
end

rule "Parser: condicion no tiene o no tienen"
agenda-group "Parser"
salience 100
when
	$linea: String(this matches "^.+?\\s+no tienen?\\s+.+$")
then
	String[] a = $linea.split("\\s+no tienen?\\s+");
	
	String sujeto = a[0].trim();
	Condicion.Tipo tipo = Condicion.Tipo.NoObjeto;
	String predicado = a[1].trim();
	
	insert(new Condicion(sujeto, tipo, predicado));
	delete($linea);
end

// Condiciones
// Parte 1: linea -> hecho intermedio
rule "Parser: dividir tenencia"
agenda-group "Parser"
salience 90
when
    $linea : String( this matches "^.+?\\s+tienen?\\s+.+$" )
then
    String[] a = $linea.split("\\s+tienen?\\s+", 2);
    insert(new Tenencia(a[0].trim(), a[1].trim()));
    delete($linea);
end

// Parte 2: una regla por hecho intermedio, mutualmente excluyentes
rule "Parser: condicion enojo"
agenda-group "Parser"
when
    $t : Tenencia( resto matches "^el enojo de\\s+.+" )
then
    insert(new Condicion($t.getSujeto(), Condicion.Tipo.Enojo,
            $t.getResto().replaceFirst("^el enojo de\\s+", "").trim()));
    delete($t);
end

rule "Parser: condicion favor"
agenda-group "Parser"
when
    $t : Tenencia( resto matches "^el favor de\\s+.+" )
then
    insert(new Condicion($t.getSujeto(), Condicion.Tipo.Favor,
            $t.getResto().replaceFirst("^el favor de\\s+", "").trim()));
    delete($t);
end

rule "Parser: condicion objeto"
agenda-group "Parser"
when
    $t : Tenencia( resto not matches "^el (enojo|favor) de\\s+.+" )
then
    insert(new Condicion($t.getSujeto(), Condicion.Tipo.Objeto, $t.getResto()));
    delete($t);
end

rule "Descartar líneas no reconocidas"
agenda-group "Parser"
salience -100
when
    $s : String()
then
    delete($s);
end
