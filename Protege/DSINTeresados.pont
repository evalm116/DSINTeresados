(defclass Mortal "Personajes mortales sin poderes divinos"
	(is-a Personaje)
	(role concrete)
	(multislot tieneFavorDe
;+		(comment "Un dios otorga su favor a un personaje para usar un objeto")
		(type INSTANCE)
