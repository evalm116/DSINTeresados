(defclass Habilidad "Un personaje tiene una habilidad dada por un objeto que posee o puede ser inherente, como volar, invisibilidad, etc"
	(is-a USER)
	(role concrete)
	(single-slot nombre
;+		(comment "Es obligatorio que un personaje tenga un nombre por el cual identificarlo")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write))
	(multislot esPermitido
;+		(comment "Una habilidad es dada por un objeto a un personaje héroe")
		(type INSTANCE)
;+		(allowed-classes Heroe Equipamiento ParteDeCriatura)
		(create-accessor read-write)))

(defclass Accion "Un personaje realiza una cierta acción a otro personaje"
	(is-a USER)
	(role abstract)
	(single-slot objetivo
;+		(comment "Personaje al que se le realiza cierta acción")
		(type INSTANCE)
;+		(allowed-classes Personaje)
;+		(cardinality 1 1)
		(create-accessor read-write))
	(single-slot autor
;+		(comment "Personaje que realiza la acción")
		(type INSTANCE)
;+		(allowed-classes Personaje)
;+		(cardinality 1 1)
		(create-accessor read-write)))

(defclass Matar
	(is-a Accion)
	(role concrete))

(defclass Liberar
	(is-a Accion)
	(role concrete))

(defclass Capturar
	(is-a Accion)
	(role concrete))

(defclass Buscar "Un personaje localiza a otro personaje para conocer su ubicación"
	(is-a Accion)
	(role concrete))

(defclass Objeto "Un elemento que ayudará al personaje a realizar distintas acciones y habilidades para obtener ciertas consecuencias"
	(is-a USER)
	(role abstract)
	(single-slot nombre
;+		(comment "Es obligatorio que un personaje tenga un nombre por el cual identificarlo")
		(type STRING)
;+		(cardinality 1 1)
		(create-accessor read-write))
	(single-slot poseedor
;+		(comment "Un objeto puede ser poseido por un personaje, de ser así no puede ser obtenido por otro personaje")
		(type INSTANCE)
;+		(allowed-classes Objeto)
;+		(cardinality 0 1)
		(create-accessor read-write)))

(defclass Equipamiento "Objeto mágicos o especiales que otorga habilidades"
	(is-a Objeto)
	(role concrete)
	(single-slot esIndestructible
