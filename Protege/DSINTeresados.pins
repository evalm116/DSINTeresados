([ontologia_Class7] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "El autor de una accion y el objetivo de la accion no pueden ser los mismos")
	(%3APAL-NAME "NoAccionASiMismo")
	(%3APAL-RANGE "(defrange ?accion :FRAME Accion)")
	(%3APAL-STATEMENT "(forall ?accion\n        (/= (autor ?accion) (objetivo ?accion))\n))"))

([ontologia_Class8] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Los personajes que no están vivos no pueden realizar una accion")
	(%3APAL-NAME "MuertosNoAccion")
	(%3APAL-RANGE "(defrange ?accion :FRAME Accion)\n(defrange ?personaje :FRAME Personaje)")
	(%3APAL-STATEMENT "(forall ?accion\n        (forall ?personaje\n                (=> (= (autor ?accion) ?personaje) \n                    (= \"true\" (coerce-to-string (estaVivo ?personaje)))\n                )\n        )\n)"))

([ontologia_Class9] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Los personajes que pertenezcan a la clase Dios siempre están vivos")
	(%3APAL-NAME "DiosesInmortales")
	(%3APAL-RANGE "(defrange ?dios :FRAME Dios)")
	(%3APAL-STATEMENT "(forall ?dios\n        (= \"true\" (coerce-to-string (estaVivo ?dios)))\n)"))
