([ontologia_Class10] of  %3APAL-CONSTRAINT

	(%3APAL-DESCRIPTION "Un personaje no puede buscarse a sí mismo")
	(%3APAL-NAME "NoBuscarASiMismo")
	(%3APAL-RANGE "(defrange ?personaje :FRAME Personaje)")
	(%3APAL-STATEMENT "(forall ?personaje\n        (=> (own-slot-not-null conoceUbicacionDe ?personaje)\n            (/= ?personaje (conoceUbicacionDe ?personaje))\n        )\n)"))

([ontologia_Class12] of  Matar

	(autor [DSINTeresados_Class46])
	(objetivo [DSINTeresados_Class34]))

